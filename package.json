{
  "name": "evacuation-strategy-simulator",
  "version": "1.0.0",
  "description": "Research-oriented software for experimentally evaluating evacuation routing strategies under dynamic building conditions.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run --testTimeout 15000",
    "test:watch": "vitest --testTimeout 15000",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:app",
    "formal:pair": "tsx experiments/runArchitectureV2FormalPair.ts",
    "diagnostic:matrix": "tsx experiments/runArchitectureV2DiagnosticMatrix.ts",
    "formal:batch": "tsx experiments/runArchitectureV2FormalBatch.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NirmanBhowmike/evacuation-strategy-simulator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/NirmanBhowmike/evacuation-strategy-simulator/issues"
  },
  "homepage": "https://github.com/NirmanBhowmike/evacuation-strategy-simulator#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  }
}
